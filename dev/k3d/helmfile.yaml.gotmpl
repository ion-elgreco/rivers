# Declarative deploy for the k3d dev cluster.
#
# Usage: helmfile sync (run from this directory)
# Driven by dev/k3d/setup.sh which creates the cluster + local registry,
# pushes images, then sync's. The operator runs with
# allowInsecureRegistry=true so it can resolve digests directly from the
# HTTP-only k3d registry — no manual digest-pinning needed on the CRs.

kubeContext: k3d-{{ env "RIVERS_K3D_CLUSTER" | default "rivers-test" }}

{{- /* Storage backend for this cluster: "surrealdb" (default) or "postgresql". */}}
{{- $backend := env "RIVERS_K8S_STORAGE_BACKEND" | default "surrealdb" }}
{{- /* In-cluster host of the k3d registry setup.sh pushed to. */}}
{{- $registry := env "RIVERS_K3D_REGISTRY" | default "k3d-rivers-registry" }}

helmDefaults:
  wait: true
  # Tight fast-fail default for local dev iteration (the rivers chart's
  # `wait-for-surreal` init container does the real readiness gating). CI sets
  # RIVERS_HELMFILE_TIMEOUT to a real value so `sync` waits for the operator +
  # storage to be ready and the deploy is deterministic.
  timeout: {{ env "RIVERS_HELMFILE_TIMEOUT" | default "15" }}
  createNamespace: true

# Pre-register repos so helmfile's automatic `helm dep build` can resolve
# subcharts (rivers depends on the upstream surrealdb chart).
repositories:
  - name: surrealdb
    url: https://helm.surrealdb.com

releases:
  # Cluster-scoped CRDs first; the rivers chart's templates reference them.
  - name: rivers-crds
    namespace: rivers
    chart: ../../deploy/helm/rivers-crds
{{- if eq $backend "postgresql" }}

  # Dev-cluster PostgreSQL. Ordered before rivers because the operator opens
  # storage on startup; an empty database migrates itself on that first open.
  - name: postgres
    namespace: rivers
    chart: ./charts/postgres-dev
{{- end }}

  # Operator + UI + SurrealDB (subchart). Depends on CRDs.
  - name: rivers
    namespace: rivers
    chart: ../../deploy/helm/rivers
    needs:
      - rivers/rivers-crds
{{- if eq $backend "postgresql" }}
      - rivers/postgres
{{- end }}
    values:
      - operator:
          # Use the locally-built image (k3d image import), not the ghcr
          # default the chart points to for releases.
          image: rivers-operator:latest
          allowInsecureRegistry: true
        ui:
          # CI (RIVERS_K8S_SKIP_UI=1) never builds/imports the UI image, so
          # don't deploy it either — the integration suite doesn't touch it.
          enabled: {{ if eq (env "RIVERS_K8S_SKIP_UI") "1" }}false{{ else }}true{{ end }}
          image: rivers-ui:latest
{{- if eq $backend "postgresql" }}
        storage:
          backend: postgresql
        surrealdb:
          # The chart refuses to install the subchart beside PostgreSQL, so
          # this is required rather than merely tidy.
          enabled: false
        postgresql:
          # The postgres-dev chart already holds the URL, credentials included.
          existingSecret: postgres
          secretKeys:
            url: url
{{- end }}

  # Dev-cluster scaffolding: RustFS + example CodeLocation CRs.
  - name: rivers-dev
    namespace: rivers
    chart: ./charts/rivers-dev
    needs:
      - rivers/rivers
    values:
      - codeLocations:
          - name: {{ env "RIVERS_K8S_TEST_CODE_LOCATION" | default "k8s-test-pipeline" }}
            image: {{ $registry }}:5000/rivers-code-location
            module: k8s_test_pipeline.pipeline
{{- if ne (env "RIVERS_K8S_SKIP_DEMO") "1" }}
          - name: {{ env "RIVERS_K8S_DEMO_CODE_LOCATION" | default "demo" }}
            image: {{ $registry }}:5000/rivers-demo
            module: demo_project.pipeline
{{- end }}
{{- if eq (env "RIVERS_K8S_AUTH") "1" }}

  # Opt-in standing OIDC provider for a browsable login. setup.sh bootstraps the
  # `rivers` client + demo user, adds the split-horizon DNS, and flips rivers-ui
  # to oidc. `wait: false` — the chart's DB-migration post-install hook deadlocks
  # helm --wait. The auth integration test installs its own separate ferriskey
  # release, so don't run `just k8s-test` while this toggle is up.
  - name: ferriskey
    namespace: rivers
    chart: oci://ghcr.io/ferriskey/charts/ferriskey
    version: 0.7.1
    wait: false
    values:
      - ferriskey-values.yaml
{{- end }}
